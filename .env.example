# Salin jadi .env.local untuk dev lokal.
# Di production, isi semua ini lewat Vercel Dashboard > Project > Settings > Environment Variables.

# --- Database (Vercel Postgres) ---
# Kalau kamu sudah connect Vercel Postgres storage ke project ini, POSTGRES_URL
# otomatis ke-inject oleh Vercel. Untuk dev lokal, tarik dengan:
#   vercel env pull .env.local
# Atau isi manual dari Storage > (nama db) > .env.local tab di dashboard Vercel.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# --- Google OAuth (dari Google Cloud Console > APIs & Services > Credentials) ---
# Aktifkan "Google Calendar API" & "Google People API" dulu di project-nya.
GOOGLE_CLIENT_ID=isi-client-id-kamu.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=isi-client-secret-kamu
# Dev lokal:
#   http://localhost:3000/api/auth/google/callback
# Production (daftarkan juga di Authorized redirect URIs Google Cloud Console):
#   https://nama-project-kamu.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Session ---
# String acak panjang, generate dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang

# --- App ---
# Dev lokal: http://localhost:3000
# Production: https://nama-project-kamu.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
