{
  "manifest_version": 3,
  "name": "StudyBuddy — Pomodoro & Site Blocker",
  "version": "1.0.0",
  "description": "Pomodoro timer dan pemblokir situs buat sesi fokus StudyBuddy, langsung dari toolbar Chrome.",
  "permissions": ["storage", "alarms", "declarativeNetRequest", "notifications", "offscreen"],
  "host_permissions": [
    "https://studybuddy.nurfikri.com/*",
    "https://studybuddy-blue-sigma.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
